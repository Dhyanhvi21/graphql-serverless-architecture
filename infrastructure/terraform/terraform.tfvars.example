aws_region            = "us-east-1"
environment           = "prod"
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_app_subnets   = ["10.0.10.0/24", "10.0.20.0/24"]
private_db_subnets    = ["10.0.30.0/24", "10.0.40.0/24"]
db_name               = "graphql_prod_db"
db_username           = "dbadmin"
db_allocated_storage  = 20
db_max_allocated_storage = 100
db_instance_class     = "db.t4g.medium"
db_multi_az           = true
ecs_cpu               = 512
ecs_memory            = 1024
ecs_desired_count     = 2
alarm_email           = "devops-alerts@mycompany.com"
github_repo_owner     = "my-organization"
github_repo_name      = "graphql-serverless-architecture"
