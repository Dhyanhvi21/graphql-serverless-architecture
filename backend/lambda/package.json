{
  "name": "serverless-graphql-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda functions in TypeScript for GraphQL operations with RDS PostgreSQL",
  "main": "dist/handlers/graphql.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "node --test dist/tests/*.test.js",
    "migrate": "node dist/db/migrate.js",
    "deploy:sls": "serverless deploy --stage prod",
    "deploy:sam": "sam build && sam deploy --config-file samconfig.toml"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "graphql": "^16.8.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.138",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.4.5"
  }
}

